msgid "Advanced Settings Created.\nReboot Kodi for settings to take effect."
msgstr "Erweiterte Einstellungen erstellt.\nStarte Kodi neu, damit die Einstellungen wirksam werden."

msgctxt "#32646"
msgid "[COLOR %s]Advanced Settings Configurator[/COLOR]"
msgstr "[COLOR %s]Konfigurator fuer erweiterte Einstellungen[/COLOR]"

msgctxt "#32647"
msgid "[COLOR %s]Video Cache Size[/COLOR]%s"
msgstr "[COLOR %s]Video-Cache-Groesse[/COLOR]%s"

msgctxt "#32648"
msgid "[COLOR %s]Number of bytes used for buffering streams in memory.  When set to [COLOR %s]0[/COLOR] the cache will be written to disk instead of RAM.  Note: For the memory size set here, Kodi will require 3x the amount of RAM to be free. Setting this too high might cause Kodi to crash if it can't get enough RAM(1/3 of Free Memory: [COLOR %s]%s[/COLOR])[/COLOR]"
msgstr "[COLOR %s]Anzahl der Bytes, die zum Puffern von Streams im Speicher verwendet werden. Bei [COLOR %s]0[/COLOR] wird der Cache stattdessen auf die Festplatte geschrieben. Hinweis: Fuer die hier eingestellte Speichergroesse benoetigt Kodi das 3-fache an freiem RAM. Ein zu hoher Wert kann zum Absturz von Kodi fuehren, wenn nicht genug RAM verfuegbar ist (1/3 des freien Speichers: [COLOR %s]%s[/COLOR])[/COLOR]"

msgctxt "#32649"
msgid "[COLOR %s]New size:[/COLOR] [COLOR %s]%s MB[/COLOR]"
msgstr "[COLOR %s]Neue Groesse:[/COLOR] [COLOR %s]%s MB[/COLOR]"

msgctxt "#32650"
msgid "[COLOR %s]Recommended:[/COLOR] [COLOR %s]%s MB[/COLOR]"
msgstr "[COLOR %s]Empfohlen:[/COLOR] [COLOR %s]%s MB[/COLOR]"

msgctxt "#32651"
msgid "[COLOR %s]CURL Timeout/CURL Low Speed[/COLOR]%s"
msgstr "[COLOR %s]CURL-Timeout/CURL-Niedriggeschwindigkeit[/COLOR]%s"

msgctxt "#32652"
msgid "[COLOR %s][B]curlclienttimeout[/B] is the time in seconds for how long it takes for libcurl connection will timeout and [B]curllowspeedtime[/B] is the time in seconds for libcurl to consider a connection lowspeed.  For slower connections set it to 20.[/COLOR]"
msgstr "[COLOR %s][B]curlclienttimeout[/B] ist die Zeit in Sekunden, nach der eine libcurl-Verbindung als Timeout gilt, und [B]curllowspeedtime[/B] ist die Zeit in Sekunden, nach der libcurl eine Verbindung als langsam einstuft. Fuer langsamere Verbindungen auf 20 setzen.[/COLOR]"

msgctxt "#32653"
msgid "[COLOR %s]New time:[/COLOR] [COLOR %s]%ss[/COLOR]"
msgstr "[COLOR %s]Neue Zeit:[/COLOR] [COLOR %s]%ss[/COLOR]"

msgctxt "#32654"
msgid "[COLOR %s]Recommended:[/COLOR] [COLOR %s]%ss[/COLOR]"
msgstr "[COLOR %s]Empfohlen:[/COLOR] [COLOR %s]%ss[/COLOR]"

msgctxt "#32655"
msgid "[COLOR %s]Read Buffer Factor[/COLOR]%s"
msgstr "[COLOR %s]Lesepuffer-Faktor[/COLOR]%s"

msgctxt "#32656"
msgid "[COLOR %s]The value of this setting is a multiplier of the default limit. If Kodi is loading a typical bluray raw file at 36 Mbit/s, then a value of 2 will need at least 72 Mbit/s of network bandwidth. However, unlike with the RAM setting, you can safely increase this value however high you want, and Kodi won't crash.[/COLOR]"
msgstr "[COLOR %s]Der Wert dieser Einstellung ist ein Multiplikator des Standardlimits. Laedt Kodi z.B. eine typische Blu-ray-Rohdatei mit 36 Mbit/s, benoetigt ein Wert von 2 mindestens 72 Mbit/s Netzwerkbandbreite. Anders als bei der RAM-Einstellung kann dieser Wert aber gefahrlos beliebig hoch gesetzt werden, ohne dass Kodi abstuerzt.[/COLOR]"

msgctxt "#32657"
msgid "[COLOR %s]New value:[/COLOR] [COLOR %s]%s[/COLOR]"
