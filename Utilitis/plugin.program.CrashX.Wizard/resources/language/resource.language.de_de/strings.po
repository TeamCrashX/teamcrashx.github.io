msgctxt "#32659"
msgid "[COLOR %s]Buffer Mode[/COLOR]%s"
msgstr "[COLOR %s]Puffermodus[/COLOR]%s"

msgctxt "#32660"
msgid "[COLOR %s]This setting will force Kodi to use a cache for all video files, including local network, internet, and even the local hard drive. Default value is 0 and will only cache videos that use internet file paths/sources.[/COLOR]"
msgstr "[COLOR %s]Diese Einstellung zwingt Kodi, fuer alle Videodateien einen Cache zu verwenden - auch fuer lokales Netzwerk, Internet und sogar die lokale Festplatte. Standardwert ist 0, dann wird nur bei Videos mit Internet-Pfaden/-Quellen gecacht.[/COLOR]"

msgctxt "#32661"
msgid "0: Buffer all internet filesystems"
msgstr "0: Alle Internet-Dateisysteme puffern"

msgctxt "#32662"
msgid "1: Buffer all filesystems"
msgstr "1: Alle Dateisysteme puffern"

msgctxt "#32663"
msgid "2: Only buffer true internet filesystems"
